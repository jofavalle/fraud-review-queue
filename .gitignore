# Data
# Anchored to the project root on purpose: an unanchored "data/" also matches
# src/fraudq/data/, which is the ingest package, not a dataset.
/data/
*.csv
*.parquet
*.pkl
*.joblib

# Credentials
.env
kaggle.json
*.pem

# Python
__pycache__/
*py[cod]
.venv/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# Model artifacts
models/*.txt
models/*.lgb
models/artifacts/

# Pipeline outputs. The figures under reports/figures/ ARE versioned: the README
# renders them.
reports/*.parquet
reports/*.csv

# System
.DS_Store
!data/**/.gitkeep
